# Production env for mycard24-web-landing — the filled-in version lives in the PROD_ENV variable on
# the repository's production environment, and CD writes it to /opt/mycard24-web-landing/.env.
#
# Nothing here is secret: the site is public, static and holds no credentials. PROD_ENV is a
# variable rather than a secret, the same split every repo here uses — SSH_KEY is the only secret.
#
# IMAGE and IMAGE_TAG are appended by CD and must not be set here; IMAGE_TAG pinning a commit SHA is
# what makes a rollback one line.

# Loopback port the host nginx proxies to. Must match deploy/nginx/mycard24.ru.conf.
LANDING_PORT=8087

LANDING_MEMORY_LIMIT=128M
